<Application x:Class="RalBgGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RalBgGenerator.Converters">
    <Application.Resources>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />

        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Application.Resources>
</Application>
