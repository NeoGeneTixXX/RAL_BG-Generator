<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Solid Edge COM ist ausschliesslich x64. Ein 32-Bit-Prozess kann sich nicht
         an den Out-of-Process-Server "SolidEdge.Application" binden. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AssemblyName>RAL_BG-Generator</AssemblyName>
    <RootNamespace>RalBgGenerator</RootNamespace>
    <StartupObject>RalBgGenerator.Program</StartupObject>

    <AssemblyTitle>RAL_BG-Generator</AssemblyTitle>
    <Product>RAL_BG-Generator</Product>
    <Description>Erzeugt aus Solid-Edge-Teilen automatisiert farbige Baugruppen.</Description>
    <Version>1.0.0</Version>

    <!-- Symbol der EXE. WPF-Fenster ohne eigenes Icon uebernehmen es automatisch
         (Titelleiste, Taskleiste). Quelle: tools\IconGenerator. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- Late binding ueber IDispatch: kein Verweis auf die Solid-Edge-Interop-Assemblies,
         damit das Projekt auch ohne installiertes Solid Edge baut. -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <!-- App.xaml wird als Page statt als ApplicationDefinition kompiliert, damit der
       explizite [STAThread]-Einstiegspunkt in Program.cs verwendet wird und nicht
       das vom WPF-SDK generierte Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
