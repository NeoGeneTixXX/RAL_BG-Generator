<Window x:Class="RalBgGenerator.Views.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zieldatei existiert bereits"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20" MaxWidth="560">
        <TextBlock Text="Die Zieldatei existiert bereits:" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="PathText" TextWrapping="Wrap" Margin="0,0,0,16" FontFamily="Consolas" />
        <TextBlock Text="Wie soll verfahren werden?" Margin="0,0,0,12" />
        <UniformGrid Columns="2" Rows="2">
            <Button Content="Überschreiben" Margin="0,0,8,8" Click="OnOverwrite" IsDefault="True" />
            <Button Content="Überspringen" Margin="0,0,0,8" Click="OnSkip" />
            <Button Content="Alle überschreiben" Margin="0,0,8,0" Click="OnOverwriteAll" />
            <Button Content="Alle überspringen" Margin="0" Click="OnSkipAll" />
        </UniformGrid>
        <Button Content="Abbrechen" HorizontalAlignment="Right" Margin="0,16,0,0"
                Click="OnCancel" IsCancel="True" />
    </StackPanel>
</Window>
